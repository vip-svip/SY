     public void handleLoadPackage(XC_LoadPackage.LoadPackageParam lpp) throws Throwable {
+        // If the modern libxposed runtime is present, the API-101 entry owns this
+        // process. This legacy entry becomes a no-op to prevent duplicate Hook chains.
+        if (isModernLibXposedRuntimeAvailable()) {
+            log("modern libxposed runtime detected; legacy entry skipped");
+            return;
+        }
         pkg = lpp.packageName;
+        // A process-global legacy Hook cannot reliably attribute calls for packages
+        // that declare a shared UID. Fail open rather than allowing package callbacks
+        // to overwrite the instance-wide pkg identity and leak one app's policy.
+        if (lpp.appInfo != null && lpp.appInfo.sharedUserId != null
+                && !lpp.appInfo.sharedUserId.isEmpty()) {
+            log("shared UID process: legacy hooks disabled for " + pkg);
+            return;
+        }
         // 自身包名绝不 Hook（否则 WebUI 的 bridge/状态查询会被自己的过滤逻辑裁掉）
