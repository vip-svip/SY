<resources>
    <!--
        The legacy Hook resource merge supplies the canonical xposed_scope
        array from its original arrays.xml. Do not define a second empty array
        here: Android resource merging rejects duplicate names. Its
        staticScope=false module metadata keeps scope dynamically user-managed.
    -->
    <string-array name="xposed_scope" />
</resources>
