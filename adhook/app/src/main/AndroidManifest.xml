<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.privacyguard.adhook">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="FX Hook"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".FxAccessibilityService"
            android:label="FX 可选辅助服务"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fx_accessibility_service" />
        </service>
        <activity android:name=".imported.shield.FxYulongShieldActivity" android:exported="false" />
        <activity android:name=".imported.shield.WhitelistActivity" android:exported="false" />
        <activity android:name=".imported.shield.WhitelistPickerActivity" android:exported="false" />
        <activity android:name=".imported.shield.BlacklistActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongVirusDatabaseActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongScanActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongFirewallActivity" android:exported="false" />
        <receiver android:name=".imported.shield.FxYulongInstallScanReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>
</manifest>