<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.privacyguard.adhook">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".FxHookApplication"
        android:label="FX Hook"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".FxOpenSourceLicensesActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="app.pwhs.blockads.ACTION_TOGGLE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/fx_yulong_ad_shortcuts" />
        </activity>
        <service
            android:name=".FxAccessibilityService"
            android:label="FX 可选辅助服务"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fx_accessibility_service" />
        </service>
        <activity android:name=".imported.shield.FxYulongScreenFilterActivity" android:exported="false" />
        <service android:name=".imported.shield.FxYulongScreenFilterService"
            android:enabled="true" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的屏幕滤镜悬浮覆盖层服务" />
        </service>
        <service android:name=".imported.shield.FxYulongRescueOverlayService"
            android:enabled="true" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的 FX 安全护盾悬浮救援入口" />
        </service>
        <receiver
            android:name=".imported.shield.FxYulongUninstallReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".imported.shield.FxYulongKeepAliveReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="de.privacyguard.adhook.shield.KEEPALIVE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".imported.shield.FxYulongBootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".imported.shield.FxYulongProtectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的前台应用管控名单提醒服务；仅读取前台应用包名并发出通知" />
        </service>
        <activity android:name=".imported.shield.FxYulongShieldActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongRescueActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongDailySummaryActivity" android:exported="false" />
        <activity
            android:name="roro.stellar.manager.authorization.FxStellarCommandGuardActivity"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:taskAffinity="de.privacyguard.adhook.commandguard"
            android:excludeFromRecents="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.youlong.hd.intent.action.COMMAND_GUARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="roro.stellar.manager.authorization.StellarPermissionRequestActivity"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:taskAffinity="com.youlong.hd.permission"
            android:excludeFromRecents="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="com.youlong.hd.intent.action.REQUEST_PERMISSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name="roro.stellar.manager.authorization.FxStellarCommandShortcutActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name="roro.stellar.manager.authorization.FxStellarManagerActivity" android:exported="false" />
        <activity android:name="roro.stellar.manager.authorization.FxStellarSecureSettingsActivity" android:exported="false" />
        <service
            android:name="roro.stellar.manager.authorization.StellarAuthorizationService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity android:name=".imported.shield.WhitelistActivity" android:exported="false" />
        <activity android:name=".imported.shield.WhitelistPickerActivity" android:exported="false" />
        <activity android:name=".imported.shield.BlacklistActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongVirusDatabaseActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongScanActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongWarningActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongBatchCleanupActivity" android:exported="false" />
        <activity android:name=".imported.shield.FxYulongIntegrityActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongFirewallActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongAppWhitelistActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongAppStatsActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongAdActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongDnsActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongAdSummaryActivity" android:exported="false" />
        <activity android:name=".imported.ad.FxYulongAdGeneralActivity" android:exported="false" />
        <receiver
            android:name=".imported.ad.FxYulongAdWidgetProvider"
            android:label="FX 广告过滤"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fx_yulong_ad_widget_info" />
        </receiver>
        <receiver android:name=".imported.ad.FxYulongAdTaskerReceiver" android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="de.privacyguard.adhook.AD_FILTER_ENABLE" />
                <action android:name="de.privacyguard.adhook.AD_FILTER_DISABLE" />
            <action android:name="app.pwhs.blockads.TASKER_START" />
            <action android:name="app.pwhs.blockads.TASKER_STOP" />
            <action android:name="de.privacyguard.adhook.VPN_START" />
            <action android:name="de.privacyguard.adhook.VPN_STOP" />
            </intent-filter>
        </receiver>
        <service android:name=".imported.ad.FxYulongAdTileService"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true" android:label="FX 广告过滤">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <receiver android:name=".imported.ad.FxYulongFirewallPackageReceiver"
            android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <receiver android:name=".imported.shield.FxYulongInstallScanReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
            <activity android:name=".imported.dia.FxDiaFridaActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaCodeEditorActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaBackupActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaDexBrowserActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaGpsPickerActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaWifiProxyActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaGlobalSettingsActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaSystemExpandActivity" android:exported="false" />
        <service
            android:name=".imported.dia.FxDiaWifiProxyTileService"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true"
            android:label="FX 系统代理">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <activity android:name=".imported.dia.FxDiaSignatureActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaActivityBrowserActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaInspectorActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaJsonActivity" android:exported="false" />
        <activity android:name=".imported.dia.FxDiaFileActivity" android:exported="false" />
    </application>
</manifest>