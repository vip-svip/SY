<?xml version="1.0" encoding="utf-8"?>
<!--
  SY Fusion 内置管理器

  设计取舍：
    · 只用 Android 框架 API，不依赖 AndroidX —— 模块打包走的是
      aapt2 + d8 + apksigner 手工链路，没有 Gradle 依赖解析，
      引入 AAR 会让构建复杂化且体积膨胀
    · minSdk 24：Android 14 拒绝安装 targetSdk < 23 的应用
    · targetSdk 34：满足新系统的前台服务与通知要求
    · 明文流量只对回环开放（见 network_security_config.xml），
      面板跑在 127.0.0.1，不开全局 usesCleartextTraffic
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.syfusion.manager"
    android:versionCode="10334"
    android:versionName="1.0.35">
    <!-- 【真机缺陷修复】targetSdk 未声明 → 新系统（Android 14+）会拒绝安装或
         降级行为；minSdk 24 与代码用法一致（无 AndroidX）。 -->
       <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
<!-- 【真机缺陷修复】versionCode/versionName 之前**没声明**，导致 aapt2 默认写 0，
     安装新包时报 INSTALL_FAILED_VERSION_DOWNGRADE（真机实测）——APP 永远无法升级。
     现在显式声明；以后每次改动 App 都要同步 +1。 -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/SyTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- 【架构变更】桌面启动项指向**原生界面**（SyNativeActivity）：
             用户要求"本地 App、联动模块而不是联动网页"。
             原生界面所有操作直接调用模块脚本（RootShell），不经过 HTTP、
             不依赖面板进程 —— 面板没起来也能用。
             MainActivity（WebView 版）保留为可选的"网页面板"入口，
             但它不再是桌面图标指向的主界面。 -->
        <activity
            android:name=".SyNativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:label="@string/app_name" />

        <service
            android:name=".CoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="network_proxy_status" />
        </service>

        <service
            android:name=".QuickTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 无障碍服务：开屏跳过 + 应用级隐私联动；与模块脚本共用 config 事实源 -->
        <service
            android:name=".SyAccessibilityService"
            android:exported="true"
            android:label="@string/acc_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- LSPosed / Xposed 模块入口（运行期可选，未装 LSPosed 时不影响本 App） -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/xposed_desc" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />

    </application>
</manifest>
