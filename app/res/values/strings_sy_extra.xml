<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== 无障碍服务 / LSPosed（Manifest 引用，不可删） ===== -->
    <string name="acc_service_label">SY 联动服务</string>
    <string name="acc_service_desc">用于开屏广告自动跳过，以及按应用收敛隐私出口（DNS/IP/VPN/节点防泄露）。数据全部本地处理，不联网、不上传。</string>
    <string name="xposed_desc">SY-Fusion 模块联动：按应用应用隐私收敛与拦截策略。需在 LSPosed 中勾选作用域并重启目标应用。</string>
    <!-- 【真机根因修复】旧 scope 只有 com.syfusion.manager —— 意味着 hook
         只对 SY 自己的进程生效，对任何目标应用（游戏/风控/需跳广告的 App）
         都不生效。这正是"hook 不工作"的真实原因（不是代码空壳）。
         xposed_scope 的语义是"模块**建议**的作用域"，用户在 LSPosed 里勾选
         的实际范围才是准。这里给出默认建议范围（常见需要 hook 的目标），
         同时用户可在 LSPosed 中自行增减。 -->
    <string-array name="xposed_scope">
        <!-- 管理器自身（用于面板与 hook 事件上报） -->
        <item>com.syfusion.manager</item>
        <!-- Android 系统框架：标识符（IMEI/IMSI/MAC）与位置 API 的宿主 -->
        <item>android</item>
        <item>com.android.systemui</item>
        <!-- WebView 与浏览器：阻止网页读取设备指纹/诱导下载 -->
        <item>com.android.webview</item>
        <item>com.android.chrome</item>
        <item>com.android.browser</item>
        <!-- 常见需要收敛隐私/跳过开屏的应用（用户可自行增减） -->
        <item>com.tencent.mm</item>
        <item>com.tencent.mobileqq</item>
        <item>com.taobao.taobao</item>
        <item>com.jingdong.app.mall</item>
        <item>com.xingin.xhs</item>
        <item>com.ss.android.ugc.aweme</item>
    </string-array>

    <!-- ===== 隐私防泄露菜单 ===== -->
    <string name="menu_privacy_status">隐私防泄露状态</string>
    <string name="menu_privacy_on">开启全部隐私防护</string>
    <string name="menu_privacy_off">关闭全部隐私防护</string>
    <string name="menu_privacy_panic">应急加固（全防护+快照）</string>
    <string name="menu_privacy_restore">恢复默认（移除规则）</string>
    <string name="menu_privacy_apps">隐私收敛应用清单</string>

    <!-- 无障碍服务（别名，供部分设备显示） -->
    <string name="acc_label">SY 联动服务</string>
    <string name="acc_desc">识别并自动点击开屏「跳过」按钮；目标应用切前台时通知模块收敛隐私出口。不读取输入、不上传任何数据。</string>

    <!-- ===== Hook 子系统 / Root / 运营商隐私 ===== -->
    <string name="menu_hook_status">Hook 能力与事件</string>
    <string name="menu_hook_events">最近 Hook 事件</string>
    <string name="menu_hook_mode">切换 Hook 模式</string>
    <string name="menu_hook_clear">清空 Hook 事件</string>
    <string name="menu_carrier_on">运营商隐私收敛（开/关）</string>
    <string name="menu_root_status">Root 权限状态</string>
</resources>
