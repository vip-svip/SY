# 打包产物（作为 Release 附件发布，不入库）
dist/
*.zip
*.sha256

# UI 截图（由 tests/ui_screenshot.js 生成，供人工验收）
shots/

# 依赖
node_modules/

# App 构建中间产物（模块只发布 app/SYManager.apk）
app/build/
*.idsig

# 离线数据包由 scripts/fetch_data.sh 现场抓取，不入 git（体积大、可复现），
# 但打包时会被一并写入发布 ZIP。
data/**/*.mmdb
data/**/*.db
data/**/*.dat
data/**/*.csv
data/**/*.gz
data/lists/*.txt
